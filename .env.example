# Copy to .env and fill in.
BOT_TOKEN=123456:your-token-from-BotFather

# Optional
# ADMIN_IDS=123456789            # Telegram user ids allowed to use /admin_money (testing)
# POKEBOT_SPRITES=artwork        # artwork (default, HD) | bw | bw-animated | none
# POKEBOT_PROVIDER=pokeapi       # pokeapi (live, cached) | mock (offline fake dex)
# POKEBOT_DATA_DIR=C:\\Users\\you\\PokebotData   # saves/cache/backups (default: PokebotData in your user folder, outside the bot folder)
# POKEBOT_BACKUP_KEEP=7          # how many daily save backups to keep (data/backups, written 04:00 UTC and on every start)
